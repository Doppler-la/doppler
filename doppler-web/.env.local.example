RESEND_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: modelo del chat (por defecto claude-sonnet-5-5)
CHAT_MODEL=
# Rate limit (integración Upstash Redis de Vercel Marketplace). OBLIGATORIO en producción: sin esto el chat queda bloqueado (cierra en falla).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Solo desarrollo: muestra el brief en la web en vez de enviarlo por email (se ignora en produccion)
CHAT_PREVIEW_BRIEF=
# Tope global de mensajes del chat por día (por defecto 500). Acota el gasto aunque el ataque venga de muchas IPs.
CHAT_DAILY_LIMIT=
# Medición: ID de GA4 (G-XXXXXXXXXX). Es público (va en el HTML). Sin esto no se carga ninguna analítica.
GA_MEASUREMENT_ID=
# WhatsApp comercial en formato internacional, solo dígitos (ej. 5491112345678). Sin esto no se muestran los links.
WHATSAPP_NUMBER=
# Webhook de Telegram (/api/telegram): confirma al instante Aprobar/Rechazar. Mismo bot y chat que usa agent/.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto propio (ej. openssl rand -hex 24); se pasa también a setWebhook como secret_token.
TELEGRAM_WEBHOOK_SECRET=
