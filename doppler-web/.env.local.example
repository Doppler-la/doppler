RESEND_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: modelo del chat (por defecto claude-sonnet-5-5)
CHAT_MODEL=
# Rate limit (integración Upstash Redis de Vercel Marketplace). OBLIGATORIO en producción: sin esto el chat queda bloqueado (cierra en falla).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Solo desarrollo: muestra el brief en la web en vez de enviarlo por email (se ignora en produccion)
CHAT_PREVIEW_BRIEF=
# Tope global de mensajes del chat por día (por defecto 500). Acota el gasto aunque el ataque venga de muchas IPs.
CHAT_DAILY_LIMIT=
